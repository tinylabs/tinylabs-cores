CAPI=2:
name: ::cm3_obs:1.0
description: Cortex-M3 obsfucated synthesizable RTL

scripts:
    check_source:
        cmd:
            - /bin/sh
            - check_source.sh
        filesets: [check_source]

filesets:
    check_source:
        files:
            - scripts/check_source.sh : {file_type: user, copyto: check_source.sh}

    rtl:
        files:
            - m3designstart/logical/cortexm3integration_ds/verilog/cm3_code_mux.v
            - m3designstart/logical/cortexm3integration_ds_obs/verilog/cortexm3ds_logic.v
            - m3designstart/logical/cortexm3integration_ds_obs/verilog/CORTEXM3INTEGRATIONDS.v
        file_type : verilogSource

targets:
    default:
        generate: [prepare_cm3_source]
        filesets : [rtl, check_source]
        hooks:
            pre_build:
               - check_source

generate:
    prepare_cm3_source:
        generator: prepare_source

generators:
    prepare_source:
        interpreter: python3
        command: scripts/prepare_source.py

    
